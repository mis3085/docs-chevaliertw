        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%d0%ba%d0%bb%d1%8e%d1%87%d0%b5%d0%b2%d1%8b%d0%b5-%d1%81%d0%b8%d0%bb%d1%8c%d0%bd%d1%8b%d0%b5-%d1%81%d1%82%d0%be%d1%80%d0%be%d0%bd%d1%8b-%d0%b2-%d1%80%d0%b5%d1%88%d0%b5%d0%bd%d0%b8%d1%8f%d1%85-%d0%b4%d0%bb%d1%8f-%d0%bf%d0%b5%d1%80%d0%b5%d0%b4%d0%be%d0%b2%d0%be%d0%b3%d0%be-%d0%bf%d1%80%d0%be%d0%b8%d0%b7%d0%b2%d0%be%d0%b4%d1%81%d1%82%d0%b2%d0%b0&#34; aria-label=&#34;Якорь&#34;&gt;#&lt;/a&gt;
