        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e8%87%aa%e5%8b%95%e8%bb%8a%e8%a3%bd%e9%80%a0%e3%81%ae%e5%8d%93%e8%b6%8a%e6%80%a7%e3%81%ae%e3%81%9f%e3%82%81%e3%81%ae%e5%8c%85%e6%8b%ac%e7%9a%84%e3%81%aa%e3%83%84%e3%83%bc%e3%83%aa%e3%83%b3%e3%82%b0&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
