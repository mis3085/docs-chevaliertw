    &lt;div id=&#34;半導体材料の高度な加工&#34; class=&#34;anchor&#34;&gt;&lt;/div&gt;
    
    &lt;span
        class=&#34;absolute top-0 w-6 transition-opacity opacity-0 ltr:-left-6 rtl:-right-6 not-prose group-hover:opacity-100&#34;&gt;
        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%e5%8d%8a%e5%b0%8e%e4%bd%93%e6%9d%90%e6%96%99%e3%81%ae%e9%ab%98%e5%ba%a6%e3%81%aa%e5%8a%a0%e5%b7%a5&#34; aria-label=&#34;アンカー&#34;&gt;#&lt;/a&gt;
